{
  "name": "ordena",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "productName": "Ordena",
  "description": "Gestión de stock y ventas",
  "author": "Ordena",
  "main": ".vite/build/main.js",
  "scripts": {
    "native:prepare:test": "node scripts/prepare-native-module.cjs node",
    "native:prepare:electron": "node scripts/prepare-native-module.cjs electron",
    "forge:prepare": "node scripts/prepare-forge-assets.cjs",
    "assets:prepare": "pnpm forge:prepare",
    "clean": "node scripts/clean-dist.cjs",
    "db:reset": "node scripts/reset-setup-seed.cjs",
    "start": "pnpm native:prepare:electron && pnpm forge:prepare && electron-forge start",
    "dev": "pnpm start",
    "package": "pnpm package:win",
    "package:win": "pnpm clean && pnpm native:prepare:electron && pnpm forge:prepare && electron-forge package --platform=win32 --arch=x64",
    "installer": "pnpm package:win && node scripts/build-windows-installer.cjs",
    "make": "pnpm installer",
    "build": "pnpm installer",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "pretest": "pnpm native:prepare:test",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^31.7.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1"
    }
  }
}
